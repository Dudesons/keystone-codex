{
  "name": "keystone-codex",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-2.0",
  "type": "module",
  "description": "Codex et carte interactive pour les donjons Mythique+ de World of Warcraft",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "extract": "node scripts/extract-mdt.mjs",
    "build:maps": "node scripts/build-maps.mjs",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "scaffold": "node scripts/scaffold-content.mjs",
    "data": "npm run extract && npm run build:maps && npm run fetch:assets && npm run scaffold",
    "test": "vitest run"
  },
  "dependencies": {
    "marked": "^15.0.7",
    "pako": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "y-websocket": "^3.1.0",
    "yaml": "^2.7.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.1",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.123.0"
  }
}
